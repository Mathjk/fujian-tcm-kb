---
import Base from '../../layouts/Base.astro';
import { u } from '../../utils/url';
import patent from '../../data/patent.json';
---
<Base title="成药" desc="常用中成药三百余种：组成、功效、适用证候">
  <div class="wrap">
    <h1 class="page-title">中成药</h1>
    <p class="page-desc">共 {patent.length} 种 · 组成、功效主治、适用证候与用药辨析 <span class="supp-tag">补充资料</span></p>

    <div class="toolbar">
      <input id="q" type="search" placeholder="搜成药名 / 证候…" />
      <span class="count" id="count">{patent.length} 种</span>
    </div>

    <div class="gl-grid" id="grid">
      {patent.map((p: any) => (
        <a class="card cy-card" href={u('/chengyao/' + p.slug)} data-t={p.name + ' ' + p.zheng.map((z: any) => z.n).join(' ')}>
          <div class="gl-name">{p.name}</div>
          <div class="cy-zheng">{p.zheng.slice(0, 4).map((z: any) => z.n).join(' · ')}</div>
          <div class="gl-desc">{p.func ? p.func.slice(0, 60) : ''}</div>
        </a>
      ))}
    </div>
    <div class="empty" id="empty" style="display:none">无相应成药</div>
  </div>

  <script>
    const q = document.getElementById('q'), count = document.getElementById('count'),
          empty = document.getElementById('empty');
    q.addEventListener('input', () => {
      const v = q.value.trim();
      let n = 0;
      document.querySelectorAll('.cy-card').forEach(c => {
        const show = !v || c.dataset.t.includes(v);
        c.style.display = show ? '' : 'none';
        if (show) n++;
      });
      empty.style.display = n ? 'none' : '';
      count.textContent = `${n} 种`;
    });
  </script>
</Base>
