---
import Base from '../layouts/Base.astro';
import glossary from '../data/glossary.json';

const cats = [...new Set(glossary.map((g) => g.category).filter(Boolean))];
const grouped = [
  ...cats.map(c => ({ c, items: glossary.filter((g) => g.category === c) })),
  { c: '其他', items: glossary.filter((g) => !g.category) },
].filter(g => g.items.length);
---
<Base title="症状词典" desc="症状名词释义三百余则">
  <div class="wrap">
    <h1 class="page-title">症状词典</h1>
    <p class="page-desc">共 {glossary.length} 则 · 症状名词之白话释义 <span class="supp-tag">补充资料</span></p>

    <div class="toolbar">
      <input id="q" type="search" placeholder="搜症状名 / 释义…" />
      <span class="count" id="count">{glossary.length} 则</span>
    </div>

    <div id="groups">
      {grouped.map(({ c, items }) => (
        <section class="sec gl-group">
          <div class="sec-h">{c}<span class="zx-c">{items.length}</span></div>
          <div class="sec-bd gl-grid">
            {items.map((g) => (
              <div class="card gl-card" id={g.name} data-t={g.name + ' ' + g.desc}>
                <div class="gl-name">{g.name}{g.division && <span class="gl-div">{g.division}</span>}</div>
                <div class="gl-desc">{g.desc}</div>
                {g.dialogue && <div class="gl-dlg">「{g.dialogue}」</div>}
              </div>
            ))}
          </div>
        </section>
      ))}
    </div>
    <div class="empty" id="empty" style="display:none">无相应词条</div>
  </div>

  <script>
    const q = document.getElementById('q'), count = document.getElementById('count'),
          empty = document.getElementById('empty');
    q.addEventListener('input', () => {
      const v = q.value.trim();
      let n = 0;
      document.querySelectorAll('.gl-card').forEach(c => {
        const show = !v || c.dataset.t.includes(v);
        c.style.display = show ? '' : 'none';
        if (show) n++;
      });
      document.querySelectorAll('.gl-group').forEach(g => {
        g.style.display = [...g.querySelectorAll('.gl-card')].some(c => c.style.display !== 'none') ? '' : 'none';
      });
      empty.style.display = n ? 'none' : '';
      count.textContent = `${n} 则`;
    });
  </script>
</Base>
