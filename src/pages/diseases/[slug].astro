---
import Base from '../../layouts/Base.astro';
import FormulaCard from '../../components/FormulaCard.astro';
import { u } from '../../utils/url';
import diseases from '../../data/diseases.json';
import formulas from '../../data/formulas.json';
import herbs from '../../data/herbs.json';

export function getStaticPaths() {
  return diseases.map((d: any) => ({ params: { slug: d.slug }, props: { d } }));
}
const { d } = Astro.props;
const myFormulas = (d.formulas ?? [])
  .map((id: string) => formulas.find((f: any) => f.id === id))
  .filter(Boolean)
  .sort((a: any, b: any) => a.index - b.index);
// herbs used across this disease's formulas
const herbIds = [...new Set(myFormulas.flatMap((f: any) => f.composition.map((c: any) => c.slug).filter(Boolean)))];
const hslug = Object.fromEntries(herbs.map((h: any) => [h.slug, h]));
const relHerbs = herbIds.map((s: any) => hslug[s]).filter(Boolean);
// herbs that claim to treat this disease in their 功用/主治 text (not in formulas)
const indicHerbs = (d.indic_herbs ?? []).map((s: any) => hslug[s]).filter(Boolean);
---
<Base title={d.name} desc={`${d.category} · 验方 ${myFormulas.length} 首`}>
  <div class="wrap">
    <h1 class="page-title">{d.name}</h1>
    <div class="d-meta" style="margin:-14px 0 30px">
      <span class="chip red">{d.category}</span>
      <span class="chip">验方 {myFormulas.length} 首</span>
      {relHerbs.length > 0 && <span class="chip pine">涉药 {relHerbs.length} 味</span>}
    </div>

    {d.desc?.length > 0 && (
      <section class="sec" style="margin-top:0">
        <div class="sec-h">病症概述</div>
        <div class="sec-bd" style="line-height:1.9;color:var(--ink-2)">
          {d.desc.map((p: string) => <p style="margin:0 0 10px">{p}</p>)}
        </div>
      </section>
    )}

    {(relHerbs.length > 0 || indicHerbs.length > 0) && (
      <section class="sec">
        <div class="sec-h">相关草药</div>
        <div class="sec-bd">
          {relHerbs.length > 0 && (
            <div class="herb-grp">
              <div class="grp-tag">验方用药</div>
              <div class="rel-list">
                {relHerbs.slice(0, 40).map((h: any) => <a class="pill" href={u('/herbs/' + h.slug)}>{h.name}</a>)}
              </div>
            </div>
          )}
          {indicHerbs.length > 0 && (
            <div class="herb-grp" style="margin-top:14px">
              <div class="grp-tag">载述主治 <span style="font-weight:400;font-size:12px;color:var(--ink-3)">各书功用中载治此症</span></div>
              <div class="rel-list">
                {indicHerbs.slice(0, 40).map((h: any) => <a class="pill indic" href={u('/herbs/' + h.slug)}>{h.name}</a>)}
              </div>
            </div>
          )}
        </div>
      </section>
    )}
    <style>
      .grp-tag { font-size: 13.5px; color: var(--ink-2); font-weight: 600; margin-bottom: 8px; }
      .pill.indic { border-style: dashed; }
    </style>

    <section class="sec">
      <div class="sec-h">验方</div>
      <div class="sec-bd" style="margin-top:16px">
        {myFormulas.map((f: any, i: number) => <FormulaCard f={f} num={i} />)}
        {myFormulas.length === 0 && <div class="empty">暂无方剂</div>}
      </div>
    </section>

    {d.trailing && (
      <section class="sec">
        <div class="sec-h">选配药 · 补充</div>
        <div class="sec-bd" style="line-height:1.9;color:var(--ink-2)">{d.trailing}</div>
      </section>
    )}

    <div style="margin:50px 0"><a href={u('/diseases')}>← 返回病症索引</a></div>
  </div>
</Base>
