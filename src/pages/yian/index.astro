---
import Base from '../../layouts/Base.astro';
import { u } from '../../utils/url';
import yian from '../../data/yian.json';
import zheng from '../../data/zhengxing.json';
const zslug2group = Object.fromEntries(zheng.map((z: any) => [z.slug, z.group]));
const groups = ['内科证候', '辨证纲领', '伤寒六经', '专科杂证'];
const byGroup = groups.map(g => ({ g, items: yian.filter((y: any) => zslug2group[y.zslug] === g) }))
  .filter(x => x.items.length);
const other = yian.filter((y: any) => !zslug2group[y.zslug]);
if (other.length) byGroup.push({ g: '其他', items: other });
---
<Base title="医案" desc="内科辨证医案：症状、治法、方药与加减">
  <div class="wrap">
    <h1 class="page-title">内科医案</h1>
    <p class="page-desc">共 {yian.length} 案 · 按证候系医案，载症状、治法、方药与加减 <span class="supp-tag">补充资料</span></p>

    <div class="toolbar">
      <input id="q" type="search" placeholder="搜证候 / 症状 / 方名…" />
      <span class="count" id="count">{yian.length} 案</span>
    </div>

    {byGroup.map(({ g, items }) => (
      <section class="sec zx-group">
        <div class="sec-h">{g}<span class="zx-c">{items.length}</span></div>
        <div class="sec-bd gl-grid">
          {items.map((y: any) => (
            <a class="card cy-card" href={u('/yian/' + y.slug)}
               data-t={y.name + ' ' + y.zhi + ' ' + y.symptoms.join(' ') + ' ' + y.fangji.map((f: any) => f.n).join(' ')}>
              <div class="gl-name">{y.name}</div>
              <div class="cy-zheng">{y.symptoms.slice(0, 3).join(' · ')}</div>
              <div class="gl-desc">{y.zhi}{y.fangji.length ? ' · 主方 ' + y.fangji[0].n : ''}</div>
            </a>
          ))}
        </div>
      </section>
    ))}
    <div class="empty" id="empty" style="display:none">无相应医案</div>
  </div>

  <script>
    const q = document.getElementById('q'), count = document.getElementById('count'),
          empty = document.getElementById('empty');
    q.addEventListener('input', () => {
      const v = q.value.trim();
      let n = 0;
      document.querySelectorAll('.cy-card').forEach(c => {
        const show = !v || c.dataset.t.includes(v);
        c.style.display = show ? '' : 'none';
        if (show) n++;
      });
      document.querySelectorAll('.zx-group').forEach(g => {
        g.style.display = [...g.querySelectorAll('.cy-card')].some(c => c.style.display !== 'none') ? '' : 'none';
      });
      empty.style.display = n ? 'none' : '';
      count.textContent = n + ' 案';
    });
  </script>
</Base>
