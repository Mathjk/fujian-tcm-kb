---
import Base from '../../layouts/Base.astro';
import { u } from '../../utils/url';
import zheng from '../../data/zhengxing.json';

const GROUPS = [
  ['辨证纲领', '八纲、脏腑、气血津液之纲领证候，辨证论治之基础'],
  ['内科证候', '内伤外感各科常见证候，详载临床表现与病机'],
  ['伤寒六经', '太阳、阳明、少阳、太阴、少阴、厥阴六经病证及经方证'],
  ['专科杂证', '妇儿、五官、皮肤等专科证候与杂病'],
];
const grouped = GROUPS.map(([g, d]) => ({ g, d, items: zheng.filter((z: any) => z.group === g) }));
---
<Base title="辨证" desc="证候辨证：纲领证候、内科证候、伤寒六经与专科杂证">
  <div class="wrap">
    <h1 class="page-title">证候辨证</h1>
    <p class="page-desc">共 {zheng.length} 证 · 载临床表现与病机分析 <span class="supp-tag">补充资料</span></p>

    <div class="toolbar">
      <input id="q" type="search" placeholder="搜证候名…" />
      <span class="count" id="count">{zheng.length} 证</span>
    </div>

    <div id="groups">
      {grouped.map(({ g, d, items }) => items.length > 0 && (
        <section class="sec zx-group">
          <div class="sec-h">{g}<span class="zx-c">{items.length}</span></div>
          <div class="zx-desc">{d}</div>
          <div class="sec-bd rel-list">
            {items.map((z: any) => (
              <a class="pill zx-pill" href={u('/bianzheng/' + z.slug)} data-n={z.name}>{z.name}</a>
            ))}
          </div>
        </section>
      ))}
    </div>
    <div class="empty" id="empty" style="display:none">无相应证候</div>
  </div>

  <script>
    const q = document.getElementById('q'), count = document.getElementById('count'),
          empty = document.getElementById('empty');
    q.addEventListener('input', () => {
      const v = q.value.trim();
      let n = 0;
      document.querySelectorAll('.zx-pill').forEach(p => {
        const show = !v || p.dataset.n.includes(v);
        p.style.display = show ? '' : 'none';
        if (show) n++;
      });
      document.querySelectorAll('.zx-group').forEach(g => {
        g.style.display = [...g.querySelectorAll('.zx-pill')].some(p => p.style.display !== 'none') ? '' : 'none';
      });
      empty.style.display = n ? 'none' : '';
      count.textContent = `${n} 证`;
    });
  </script>
</Base>
