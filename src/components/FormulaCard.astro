---
import { u, BOOK_FULL } from '../utils/url';
interface Props { f: any; num?: number; }
const { f, num } = Astro.props;
const ITEM_MARK = /(?=[（(][0-9０-９一二三四五六七八九十]+[)）])|(?=[①②③④⑤⑥⑦⑧⑨⑩])/g;
const splitItems = (t: string) => t.split(ITEM_MARK).map(s => s.trim()).filter(Boolean);
---
<div class="card fx-card" id={f.id}>
  <div class="fx-head">
    <span class="fx-name">{num != null ? `方 ${'①②③④⑤⑥⑦⑧⑨⑩'[num] ?? num + 1}` : (f.disease ? `${f.disease}方` : '验方')}</span>
    {f.book && <span class="fx-src">{BOOK_FULL[f.book] ?? f.book}{f.pnum ? ` 第${f.pnum}页` : ''}</span>}
    {f.source && <span class="fx-src">· {f.source}</span>}
  </div>
  {f.composition?.length > 0 && (
    <div class="fx-row">
      <span class="label-tag">组成</span>
      <div class="fx-comp">
        {f.composition.map((c: any) => (
          c.herb_id
            ? <a class="fx-ing" href={u('/herbs/' + c.slug)} title={c.dose || undefined}>{c.herb}</a>
            : <span class="fx-ing no" title={c.dose ? c.dose + ' · 未收录为词条' : '未收录为词条'}>{c.herb}</span>
        ))}
      </div>
    </div>
  )}
  {f.prescription && <div class="fx-row"><span class="label-tag">处方</span><span>{f.prescription}</span></div>}
  {f.preparation && <div class="fx-row"><span class="label-tag">制法</span><span class="fx-txt">{splitItems(f.preparation).map((s: string, i: number, a: string[]) => a.length > 1 ? <span class="fx-li">{s}</span> : s)}</span></div>}
  {f.usage && <div class="fx-row"><span class="label-tag">用法</span><span class="fx-txt">{splitItems(f.usage).map((s: string, i: number, a: string[]) => a.length > 1 ? <span class="fx-li">{s}</span> : s)}</span></div>}
  {f.efficacy && <div class="fx-row"><span class="label-tag">疗效</span><span class="fx-txt">{splitItems(f.efficacy).map((s: string, i: number, a: string[]) => a.length > 1 ? <span class="fx-li">{s}</span> : s)}</span></div>}
  {f.note && <div class="fx-row"><span class="label-tag">备注</span><span class="fx-txt">{splitItems(f.note).map((s: string, i: number, a: string[]) => a.length > 1 ? <span class="fx-li">{s}</span> : s)}</span></div>}
</div>
